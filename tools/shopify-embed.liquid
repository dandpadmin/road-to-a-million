<div class="rtam-band">
  <iframe id="rtam-frame"
    src="https://dandpadmin.github.io/road-to-a-million/"
    title="Road To A Million live dashboard"
    scrolling="no"
    style="display:block;width:100%;height:1400px;border:0"></iframe>
</div>

<style>
  .rtam-band{background:#1C242C;width:100vw;margin-left:calc(50% - 50vw)}
</style>

<script>
  (function () {
    var f = document.getElementById('rtam-frame');
    /* Bring the top of the dashboard into view when the frame changes page
       (Archive, or back to the live dashboard). Only scrolls up, never down,
       and clears the store's sticky header. */
    function toTop() {
      var hdr = document.querySelector('sticky-header, .shopify-section-header-sticky, header');
      var off = 0;
      if (hdr) { var r = hdr.getBoundingClientRect(); if (r.top <= 0 && r.bottom > 0 && r.bottom < 200) off = r.bottom; }
      var top = f.getBoundingClientRect().top + window.pageYOffset - off;
      if (window.pageYOffset > top + 2) window.scrollTo(0, Math.max(0, top));
    }
    var loads = 0;
    f.addEventListener('load', function () { if (loads++ > 0) toTop(); });
    window.addEventListener('message', function (e) {
      if (!e.data || e.source !== f.contentWindow) return;
      if (e.data.type === 'rtam:height' && e.data.height > 400) {
        f.style.height = e.data.height + 'px';
      } else if (e.data.type === 'rtam:top') {
        toTop();
      }
    });
    setInterval(function () {
      try { f.contentWindow.postMessage({ type: 'rtam:ping' }, '*'); } catch (err) {}
    }, 1000);
  })();
</script>
